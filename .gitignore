*.pyc
__pycache__/

.env
wandb
.devcontainer/

# local HF-layout artifact build (see src/build_artifacts.py)
RoboBench/artifacts/

# data/ is the local input tree for src/build_artifacts.py; frames and
# instruction files ship inside the artifacts on Hugging Face
RoboBench/data/

# attack trees written by src/build_attacks.py, reviewed and then built
# into artifacts by src/build_artifacts.py; the parquets ship on Hugging Face
RoboBench/generated_attacks/

# Local, potentially large per-query logs from artifact generation.
RoboBench/workdir/generation-logs/

# Reproducible Table 12 environments, downloads, and verbose query traces.
RoboBench/workdir/table12/.venv/
RoboBench/workdir/table12/guard-venv/
RoboBench/workdir/table12/hf/
RoboBench/workdir/table12/graph-preflight/
RoboBench/workdir/table12/release/data/
RoboBench/workdir/table12/*.log
